# Copie para `.env` e ajuste o que precisar.
#
# Para DESENVOLVER, uma linha basta: `DEBUG=True`. O resto tem padrão — sem as
# outras variáveis o projeto usa SQLite, guarda uploads no disco local e
# imprime os e-mails no terminal.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# DEBUG é False por PADRÃO no settings.py, e a inversão é deliberada: com o
# padrão antigo (`True`), bastava a variável sumir do painel do Render para o
# site subir servindo stack traces — que incluem `os.environ`, ou seja, a
# senha do banco e o segredo do Cloudinary. O modo perigoso não pode ser o que
# se obtém por omissão.
#
# Ligue para desenvolver:
DEBUG=True

# Obrigatória quando DEBUG=False — o settings recusa subir com a chave de
# desenvolvimento. Gere uma com:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# SECRET_KEY=
# ALLOWED_HOSTS=meu-portfolio.onrender.com
#
# CSRF_TRUSTED_ORIGINS não precisa ser configurada: o settings a deriva de
# ALLOWED_HOSTS automaticamente.

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# Sem esta variável o projeto usa SQLite em db.sqlite3.
# No Render, cole a "Internal Database URL" do PostgreSQL.
# DATABASE_URL=postgres://usuario:senha@host:5432/banco

# ---------------------------------------------------------------------------
# Mídia — Cloudinary
# ---------------------------------------------------------------------------
# O disco do Render é efêmero: sem isto, as imagens dos projetos e os PDFs dos
# certificados enviados pelo admin somem no deploy seguinte.
# A URL única está no dashboard do Cloudinary, em "API Environment variable".
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ---------------------------------------------------------------------------
# E-mail — formulário de contato
# ---------------------------------------------------------------------------
# Por padrão as mensagens aparecem no terminal, sem configurar SMTP. Em
# qualquer caso a mensagem também é gravada no banco e aparece no admin, então
# uma falha de SMTP nunca perde um contato.
#
# Com Gmail, use uma "senha de app" (https://myaccount.google.com/apppasswords),
# nunca a senha da conta.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=dedegritten@gmail.com
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=Portfólio André Gritten <dedegritten@gmail.com>
# EMAIL_DESTINO=dedegritten@gmail.com
